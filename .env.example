# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=darwin_db

# Flask Security
FLASK_SECRET_KEY=change-me

# Natural Selection Evolution Parameters
EVOLUTION_FEEDBACK_THRESHOLD=5
MIN_AGENT_USES_FOR_EVOLUTION=3
EVOLUTION_K=1
POPULATION_FLOOR=3

# Groq safety controls
GROQ_MAX_RETRIES=0
GROQ_MIN_REQUEST_INTERVAL_SEC=0.8
GROQ_REQUESTS_PER_MINUTE=25
GROQ_CIRCUIT_OPEN_SEC=60
